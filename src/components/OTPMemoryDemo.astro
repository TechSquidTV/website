---
interface Props {
  linked?: boolean;
}
const { linked = false } = Astro.props;
---

<otp-memory-demo
  class="not-prose"
  data-linked={linked}
  data-provision-label={linked ? "Provision device" : "Provision random key"}
>
  <h3>One Time Programmable Memory</h3>
  <div class="otp-scroll">
    <div
      class="otp-grid"
      role="grid"
      aria-label="128 programmable fuses, 8 rows and 16 columns"
    >
      {
        Array.from({ length: 8 }, (_, row) => (
          <div role="row">
            {Array.from({ length: 16 }, (_, column) => {
              const bit = row * 16 + column;
              return (
                <div role="gridcell">
                  <button
                    type="button"
                    data-bit={bit}
                    disabled
                    tabindex={bit === 0 ? 0 : -1}
                    aria-label={`Bit ${bit}, row ${row + 1}, column ${column + 1}: intact, 0. Burn fuse.`}
                  >
                    /
                  </button>
                </div>
              );
            })}
          </div>
        ))
      }
    </div>
  </div>
  <div class="otp-readout">
    <span class="otp-key-label">{linked ? "HUK · 128-bit" : "AES-128"}</span>
    <output
      aria-label={linked
        ? "Simulated hardware unique key in hexadecimal"
        : "AES-128 key in hexadecimal"}
    >
      {Array.from({ length: 4 }, () => <span data-key-group>00000000</span>)}
    </output>
  </div>
  <div class="otp-actions">
    <button type="button" data-provision disabled
      >{linked ? "Provision device" : "Provision random key"}</button
    >
    <button type="button" data-replace disabled
      ><svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M20 7v5h-5M4 17v-5h5"></path><path
          d="M6 6a8 8 0 0 1 13 3l1 3M4 12l1 3a8 8 0 0 0 13 3"></path></svg
      >Replace SoC</button
    >
  </div>
  <p class="sr-only" role="status" data-status></p>
  <noscript>Enable JavaScript to use this demo.</noscript>
</otp-memory-demo>

<script>
  import "@/lib/otp-memory-demo";
</script>

<style>
  otp-memory-demo {
    display: block;
    margin: var(--content-block-spacing) 0;
    color: var(--foreground);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .otp-scroll {
    overflow-x: auto;
    padding: 3px;
    margin: -3px;
  }
  otp-memory-demo[data-replacing] .otp-scroll {
    overflow: hidden;
  }
  h3 {
    margin: 0 0 1rem;
    font-size: 1.125rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .otp-readout {
    display: flex;
    align-items: stretch;
    margin-top: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-top: 0;
    background: var(--background);
  }
  .otp-key-label {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0.75rem 1rem;
    border-right: 1px solid var(--border);
    background: color-mix(in oklch, var(--background) 92%, white);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted-foreground);
  }
  output {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.8rem;
    padding: 0.75rem 1rem;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.875rem, 2.5vw, 1.125rem);
  }
  .otp-grid {
    position: relative;
    overflow: hidden;
    min-width: 529px;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }
  .otp-grid[data-hover]::before,
  .otp-grid[data-hover]::after {
    content: "";
    position: absolute;
    pointer-events: none;
    background: color-mix(in oklch, var(--foreground) 5%, transparent);
    z-index: 2;
  }
  .otp-grid[data-hover]::before {
    left: 0;
    right: 0;
    top: calc(var(--hover-row) * 100% / 8);
    height: calc(100% / 8);
  }
  .otp-grid[data-hover]::after {
    top: 0;
    bottom: 0;
    left: calc(var(--hover-column) * 100% / 16);
    width: calc(100% / 16);
  }
  .otp-grid [role="row"] {
    display: grid;
    grid-template-columns: repeat(16, minmax(33px, 1fr));
  }
  .otp-grid [role="gridcell"] {
    min-width: 0;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  button {
    font: inherit;
    cursor: pointer;
  }
  .otp-grid button {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    min-height: 32px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 1.125rem;
  }
  .otp-grid button:hover:not(:disabled):not([aria-disabled="true"]) {
    background: var(--muted);
  }
  .otp-grid button[aria-disabled="true"] {
    background: var(--muted);
    cursor: default;
  }
  button:focus-visible {
    position: relative;
    outline: 2px solid var(--ring);
    outline-offset: 1px;
    z-index: 1;
  }
  .otp-grid button:focus-visible {
    outline-offset: -2px;
    z-index: 3;
  }
  button:disabled {
    cursor: default;
    opacity: 0.5;
  }
  .otp-actions {
    margin-top: 1rem;
    display: flex;
    gap: 0.5rem;
  }
  .otp-actions button {
    flex: 1 1 0;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    min-height: 36px;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--background);
    color: var(--foreground);
    font-weight: 500;
  }
  .otp-actions button:hover:not(:disabled) {
    background: var(--muted);
  }
</style>
