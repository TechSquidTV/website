---
import { Icon } from "astro-icon/components";
import { SITE_TITLE } from "@/consts";

const currentPath = Astro.url.pathname;

// Navigation data
const navItems = [
  {
    href: "/blog",
    label: "Blog",
    icon: "rss",
    isActive: currentPath.startsWith("/blog"),
  },
  {
    href: "/about",
    label: "About",
    icon: "verified",
    isActive: currentPath === "/about",
  },
  {
    href: "/follow",
    label: "Follow",
    icon: "youtube",
    isActive: currentPath === "/follow",
  },
  {
    href: "/contact",
    label: "Contact",
    icon: "email",
    isActive: currentPath === "/contact",
  },
];

const navLinkClasses = (isActive: boolean, mobile = false): string =>
  [
    "text-sm font-medium no-underline transition-colors",
    mobile && "focus-ring block py-2.5",
    isActive
      ? "text-foreground"
      : "text-muted-foreground hover:text-foreground",
  ]
    .filter(Boolean)
    .join(" ");
---

<header
  class="border-border bg-background/90 sticky top-0 z-50 border-b backdrop-blur"
>
  <div class="container-page py-2 sm:py-3">
    <nav class="flex items-center justify-between">
      <!-- Logo/Brand Section -->
      <a href="/" class="flex items-center gap-2.5 no-underline">
        <Icon name="techsquidtv" size={28} aria-label="TechSquidTV logo" />
        <span class="text-foreground text-lg leading-none font-semibold">
          {SITE_TITLE}
        </span>
      </a>

      <!-- Desktop navigation -->
      <div class="hidden items-center gap-6 lg:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={navLinkClasses(item.isActive)}
              aria-current={item.isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center lg:justify-self-end">
        <button
          id="mobile-menu-btn"
          class="text-muted-foreground hover:text-foreground focus-ring inline-flex h-11 w-11 items-center justify-center transition-colors lg:hidden"
          aria-label="Toggle mobile menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <Icon name="menu" size={20} />
        </button>
      </div>
    </nav>

    <!-- Mobile Navigation Menu -->
    <div
      id="mobile-menu"
      class="border-border mt-2 hidden border-t lg:hidden"
      aria-label="Mobile navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={navLinkClasses(item.isActive, true)}
            aria-current={item.isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>
<script>
  const closeMenu = () => {
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (mobileMenuBtn && mobileMenu) {
      mobileMenu.classList.add("hidden");
      mobileMenuBtn.setAttribute("aria-expanded", "false");
    }
  };

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (!mobileMenuBtn || !mobileMenu) return;

    if (event.target.closest("#mobile-menu-btn")) {
      const isHidden = mobileMenu.classList.contains("hidden");

      if (isHidden) {
        mobileMenu.classList.remove("hidden");
        mobileMenuBtn.setAttribute("aria-expanded", "true");
      } else {
        closeMenu();
      }
      return;
    }

    if (!mobileMenu.contains(event.target)) {
      closeMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
