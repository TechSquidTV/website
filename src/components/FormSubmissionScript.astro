<script>
  interface TurnstileApi {
    reset(widget?: HTMLElement): void;
  }

  interface TurnstileWindow extends Window {
    turnstile?: TurnstileApi;
  }

  function valueFromForm(form: HTMLFormElement, name: string): string {
    const value = new FormData(form).get(name);
    return typeof value === "string" ? value : "";
  }

  function messageFromResponse(value: unknown): string {
    if (
      typeof value === "object" &&
      value !== null &&
      "message" in value &&
      typeof value.message === "string"
    ) {
      return value.message;
    }

    return "Unable to process your submission. Please try again.";
  }

  function setStatus(
    status: HTMLElement,
    message: string,
    isError: boolean,
  ): void {
    status.textContent = message;
    status.classList.toggle("text-red-500", isError);
    status.classList.toggle("text-green-600", !isError);
  }

  function initialiseForm(form: HTMLFormElement): void {
    if (form.dataset.submissionInitialised === "true") {
      return;
    }

    const endpoint = form.dataset.formEndpoint;
    const kind = form.dataset.formKind;
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submitButton = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );

    if (!endpoint || !kind || !status || !submitButton) {
      return;
    }

    form.dataset.submissionInitialised = "true";
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submitButton.disabled = true;
      setStatus(status, "Submitting…", false);

      const payload: Record<string, string> = {
        dontCheckMe: valueFromForm(form, "dontCheckMe"),
        email: valueFromForm(form, "email"),
        name: valueFromForm(form, "name"),
        turnstileToken: valueFromForm(form, "cf-turnstile-response"),
      };

      if (kind === "contact") {
        payload.message = valueFromForm(form, "message");
      }

      try {
        const response = await fetch(endpoint, {
          body: JSON.stringify(payload),
          headers: { "Content-Type": "application/json" },
          method: "POST",
        });
        const body: unknown = await response.json();
        const message = messageFromResponse(body);

        if (!response.ok) {
          setStatus(status, message, true);
          return;
        }

        form.reset();
        (window as TurnstileWindow).turnstile?.reset(
          form.querySelector<HTMLElement>(".cf-turnstile") ?? undefined,
        );
        setStatus(status, message, false);
      } catch {
        setStatus(
          status,
          "Unable to process your submission. Please try again.",
          true,
        );
      } finally {
        submitButton.disabled = false;
      }
    });
  }

  document
    .querySelectorAll<HTMLFormElement>("[data-form-endpoint]")
    .forEach(initialiseForm);
</script>
