---
import { Icon } from "astro-icon/components";

export interface Props {
  url: string;
  text?: string;
  tooltip?: string;
  showIcon?: boolean;
}

const { url, text, tooltip, showIcon = true } = Astro.props;

// Extract article title from Wikipedia URL as fallback
const getArticleTitle = (wikipediaUrl: string): string => {
  try {
    const match = wikipediaUrl.match(/\/wiki\/(.+)$/);
    const encodedTitle = match?.[1];
    if (encodedTitle) {
      return decodeURIComponent(encodedTitle).replace(/_/g, " ");
    }
  } catch {
    // Fallback to URL if parsing fails
  }
  return wikipediaUrl;
};

// Check if there's slot content
const hasSlotContent = Astro.slots.has("default");
const fallbackText = text || getArticleTitle(url);
---

<span
  class="wiki-link-wrapper"
  data-tooltip={tooltip}
  data-has-tooltip={tooltip ? "true" : "false"}
>
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="wiki-link"
    aria-label={tooltip
      ? `${hasSlotContent ? "Wikipedia link" : fallbackText} - ${tooltip}`
      : hasSlotContent
        ? "Wikipedia link"
        : fallbackText}
  >
    {hasSlotContent ? <slot /> : fallbackText}
  </a>
  {showIcon && <Icon name="search" class="wiki-icon" aria-hidden="true" />}
</span>

<style>
  .wiki-link-wrapper {
    position: relative;
    display: inline;
  }

  .wiki-link {
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-decoration-color: var(--muted-foreground);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .wiki-link:hover,
  .wiki-link:focus-visible {
    text-decoration-color: var(--foreground);
    text-decoration-thickness: 2px;
  }

  .wiki-icon {
    width: 0.5rem;
    height: 0.5rem;
    opacity: 0.6;
    vertical-align: super;
    transition: opacity 0.2s ease;
    display: inline-block;
  }

  .wiki-link-wrapper:hover .wiki-icon {
    opacity: 1;
  }

  /* Tooltip styles */
  .wiki-link-wrapper[data-has-tooltip="true"]:is(:hover, :focus-within)::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--card);
    color: var(--foreground);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    line-height: 1.5;
    white-space: normal;
    width: min(24rem, calc(100vw - 2rem));
    border: 1px solid var(--border);
    z-index: 50;
    pointer-events: none;
    margin-bottom: 8px;
  }

  /* Tooltip arrow */
  .wiki-link-wrapper[data-has-tooltip="true"]:is(
      :hover,
      :focus-within
    )::before {
    content: "";
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--card);
    z-index: 50;
    pointer-events: none;
  }
</style>
