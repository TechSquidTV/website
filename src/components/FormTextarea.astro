---
interface Props {
  id: string;
  name: string;
  label: string;
  placeholder?: string;
  required?: boolean;
  rows?: number;
  note?: string;
  className?: string;
}

const {
  id,
  name,
  label,
  placeholder,
  required = false,
  rows = 4,
  note,
  className = "",
} = Astro.props;
---

<div class={`mb-6 ${className}`}>
  <label for={id} class="text-text-primary mb-2 block font-semibold">
    {label}
  </label>
  <textarea
    id={id}
    name={name}
    placeholder={placeholder}
    required={required}
    rows={rows}
    class="form-control min-h-[120px] resize-y"></textarea>
  {note && <p class="text-text-muted mt-2 text-sm">{note}</p>}
</div>
