---
import { Icon } from "astro-icon/components";

type LinkCardIcon = "file-3d" | "github" | "link";

export interface Props {
  href: string;
  title: string;
  description: string;
  icon?: LinkCardIcon;
  external?: boolean;
}

const {
  href,
  title,
  description,
  icon = "link",
  external = true,
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="link-card border-border hover:text-foreground group my-5 flex items-center gap-3 border-y py-4 no-underline transition-colors"
>
  <span
    class="border-border text-muted-foreground flex h-8 w-8 shrink-0 items-center justify-center border"
  >
    <Icon name={icon} size={16} aria-hidden="true" />
  </span>
  <span class="min-w-0 flex-1">
    <span class="text-foreground block text-sm font-semibold">{title}</span>
    <span class="text-muted-foreground mt-0.5 block text-xs">{description}</span
    >
  </span>
  <span
    class="text-muted-foreground group-hover:text-foreground text-sm transition-colors"
    aria-hidden="true">→</span
  >
</a>
