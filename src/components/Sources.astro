---
import type { Source } from "@/lib/sources";

interface Props {
  sources: readonly Source[];
}

const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section
      class="sources content-divider mt-12 border-t pt-5"
      aria-labelledby="sources-heading"
    >
      <h2 id="sources-heading" class="m-0 text-lg leading-none font-semibold">
        Sources
      </h2>
      <ol class="sources-list" role="list">
        {sources.map((source, index) => (
          <li
            itemprop="citation"
            itemscope
            itemtype="https://schema.org/CreativeWork"
          >
            <span class="source-number" aria-hidden="true">
              [{index + 1}]
            </span>
            <a itemprop="url" href={source.url} target="_blank" rel="noopener">
              <span itemprop="name">{source.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .sources {
    border-color: var(--border);
  }

  .sources-list {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sources-list li {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.5rem;
    margin: 0.375rem 0;
    padding: 0;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .source-number {
    color: var(--muted-foreground);
  }

  .sources-list a {
    overflow-wrap: anywhere;
    color: var(--foreground);
    text-decoration-color: var(--border);
    text-underline-offset: 0.15em;
  }

  .sources-list a:hover {
    text-decoration-color: var(--primary);
  }
</style>
