---
import {
  IDENTITY_PROFILES,
  PERSONAL_INFO,
  SITE_DESCRIPTION,
  SITE_TITLE,
  EXPERTISE_AREAS,
} from "@/consts";
import { OPEN_GRAPH_IMAGE_EXTENSION } from "@/lib/open-graph-theme";

interface Props {
  type?: "Person" | "BlogPosting" | "ProfilePage";
  pageUrl?: string | undefined;
  title?: string | undefined;
  description?: string | undefined;
  publishDate?: Date | undefined;
  updatedDate?: Date | undefined;
  readingTime?: number | undefined;
  wordCount?: number | undefined;
}

const {
  type = "Person",
  pageUrl = Astro.url.href,
  title,
  description,
  publishDate,
  updatedDate,
  readingTime,
  wordCount,
} = Astro.props;

// Build comprehensive author object
const authorSchema = {
  "@type": "Person",
  "@id": `${Astro.site}#author`,
  name: PERSONAL_INFO.name,
  alternateName: PERSONAL_INFO.username,
  url: PERSONAL_INFO.website,
  email: PERSONAL_INFO.email,
  image: {
    "@type": "ImageObject",
    url: `${Astro.site}brand/tstvprofile.png`,
    width: 400,
    height: 400,
  },
  description: SITE_DESCRIPTION,
  jobTitle: PERSONAL_INFO.jobTitle,
  worksFor: [
    {
      "@type": "Organization",
      name: PERSONAL_INFO.company,
    },
    {
      "@type": "Organization",
      name: PERSONAL_INFO.corporateCompany,
    },
  ],
  knowsAbout: EXPERTISE_AREAS, // ← Now uses the constants!
  sameAs: IDENTITY_PROFILES.map((link) => link.url),
  mainEntityOfPage: `${Astro.site}about`,
};

const siteGraph = [
  authorSchema,
  {
    "@type": "Organization",
    "@id": `${Astro.site}#organization`,
    name: SITE_TITLE,
    url: Astro.site,
    logo: {
      "@type": "ImageObject",
      url: `${Astro.site}favicon.svg`,
    },
    founder: {
      "@id": `${Astro.site}#author`,
    },
    sameAs: IDENTITY_PROFILES.map((link) => link.url),
  },
  {
    "@type": "WebSite",
    "@id": `${Astro.site}#website`,
    url: Astro.site,
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    inLanguage: "en-US",
    publisher: {
      "@id": `${Astro.site}#organization`,
    },
    author: {
      "@id": `${Astro.site}#author`,
    },
  },
];

let schema;

if (type === "BlogPosting" && title) {
  // Blog post schema with authorship + reading metrics
  schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: description,
    url: pageUrl,
    inLanguage: "en-US",
    datePublished: publishDate?.toISOString(),
    dateModified: (updatedDate || publishDate)?.toISOString(),
    author: authorSchema,
    publisher: {
      "@type": "Organization",
      name: SITE_TITLE,
      url: Astro.site,
      logo: {
        "@type": "ImageObject",
        url: `${Astro.site}favicon.svg`,
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": pageUrl,
    },
    isPartOf: {
      "@type": "Blog",
      "@id": `${Astro.site}#blog`,
      name: `${SITE_TITLE} Blog`,
      url: new URL("blog/", Astro.site).href,
    },
    image: {
      "@type": "ImageObject",
      url: `${pageUrl.replace(/\/$/, "")}.${OPEN_GRAPH_IMAGE_EXTENSION}`.replace(
        "/blog/",
        "/open-graph/blog/",
      ),
    },
    // 📖 READING METRICS (part of BlogPosting, not Author!)
    ...(wordCount && { wordCount: wordCount }),
    ...(readingTime && { timeRequired: `PT${Math.ceil(readingTime)}M` }),
  };
} else if (type === "ProfilePage") {
  schema = {
    "@context": "https://schema.org",
    "@graph": [
      ...siteGraph,
      {
        "@type": "ProfilePage",
        "@id": `${pageUrl}#profile`,
        url: pageUrl,
        mainEntity: {
          "@id": `${Astro.site}#author`,
        },
      },
    ],
  };
} else {
  // Person/Organization schema for general pages
  schema = {
    "@context": "https://schema.org",
    "@graph": siteGraph,
  };
}
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
  is:inline
/>
