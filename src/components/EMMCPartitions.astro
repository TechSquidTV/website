---
// cspell:ignore emmc BPUA mmcblk
import layout from "@/lib/lg-emmc-layout.json";
// LG_32LM620BPUA runtime inventory, 2026-08-29: proc-partitions.txt.
// These are separate hardware regions; the drawing is not to scale.
// Boot descriptions checked against eMMC/boot-partitions/20260829T232227Z:
// both raw images match their recorded SHA-256 checksums; boot1 is all zero.
// General boot-region purpose: docs.kernel.org/driver-api/mmc/mmc-dev-parts.html.
// Contents alone do not establish which region the device selects at boot.
const regions = [
  {
    name: "User area",
    size: `${(layout.userAreaBytes / 1024 ** 3).toFixed(2)} GiB`,
    pattern: "lines",
    device: "mmcblk0",
    description:
      "Main firmware and data storage. A dump of this device includes its logical partitions, but excludes the boot regions and RPMB.",
  },
  {
    name: "Boot 0",
    size: `${layout.bootBytes / 1024 ** 2} MiB`,
    pattern: "dots",
    device: "mmcblk0boot0",
    description:
      "Dedicated hardware region for bootloader code or boot configuration, separate from the operating-system partitions. This TV’s capture contains data here.",
  },
  {
    name: "Boot 1",
    size: `${layout.bootBytes / 1024 ** 2} MiB`,
    pattern: "horizontal",
    device: "mmcblk0boot1",
    description:
      "A second, separate hardware boot region—not a second boot stage. This TV’s entire 4 MiB capture is zero-filled, with no backup boot image present in the dump.",
  },
  {
    name: "RPMB",
    size: `${layout.rpmbBytes / 1024} KiB`,
    pattern: "crosshatch",
    device: "mmcblk0rpmb",
    description:
      "Replay Protected Memory Block. Valid writes require authentication and the correct write counter. Root access does not supply the secret key. Contents were not acquired in this capture.",
  },
];
const descriptionId = `emmc-description-${crypto.randomUUID()}`;
---

<emmc-partitions class="emmc not-prose" aria-label="eMMC hardware regions">
  <h3>eMMC Partitions</h3>
  <figure>
    <div class="emmc-layout">
      {
        regions.map((region, index) => (
          <button
            type="button"
            class:list={["emmc-region", region.pattern]}
            data-region
            data-region-name={region.name}
            aria-pressed={index === 0}
            aria-describedby={`${descriptionId}-${region.device}`}
          >
            <span class="emmc-label">
              <strong>{region.name}</strong>
              <span>{region.size}</span>
            </span>
          </button>
        ))
      }
    </div>
    <div class="emmc-access">
      {
        regions.map((region, index) => (
          <span
            class="emmc-device"
            data-device
            data-active={index === 0 ? "" : undefined}
          >
            {region.device}
          </span>
        ))
      }
      <span class="emmc-raw">Raw block access</span>
      <span class="emmc-auth"
        ><svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><rect x="5" y="10" width="14" height="11" rx="2"></rect><path
            d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg
        >Authenticated protocol</span
      >
    </div>
    <div class="emmc-description">
      {
        regions.map((region, index) => (
          <p
            id={`${descriptionId}-${region.device}`}
            data-description
            aria-hidden={index !== 0}
          >
            <strong>{region.name}:</strong> {region.description}
          </p>
        ))
      }
    </div>
  </figure>
</emmc-partitions>

<script>
  import "@/lib/emmc-partitions";
</script>

<style>
  .emmc {
    display: block;
    margin: var(--content-block-spacing) 0;
    color: var(--foreground);
    font: 0.875rem/1.5 var(--font-ui);
  }
  h3 {
    margin: 0 0 1rem;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  figure {
    position: relative;
    margin: 0;
  }
  .emmc-layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .emmc-region {
    border: 0;
    padding: 0;
    border-radius: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    --pattern-ink: color-mix(in oklch, var(--foreground) 12%, transparent);
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: clamp(8rem, 20vw, 11rem);
    background-color: var(--background);
  }
  .emmc-region + .emmc-region {
    border-left: 1px solid var(--border);
  }
  .emmc-region:hover,
  .emmc-region:focus-visible,
  .emmc-region[aria-pressed="true"] {
    --pattern-ink: color-mix(in oklch, var(--foreground) 22%, transparent);
    outline: 1px solid var(--ring);
    outline-offset: -1px;
  }
  .emmc-access {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-top: 0;
    background: var(--card);
  }
  .emmc-access > span {
    padding: 0.5rem 0.375rem;
    text-align: center;
    font-size: 0.6875rem;
  }
  .emmc-device {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
    color: var(--muted-foreground);
  }
  .emmc-device + .emmc-device {
    border-left: 1px solid var(--border);
  }
  .emmc-raw {
    grid-column: span 3;
    border-top: 1px solid var(--border);
  }
  .emmc-auth {
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    background: var(--muted);
    overflow-wrap: anywhere;
  }
  .emmc-auth svg {
    display: inline;
    vertical-align: -2px;
    margin-right: 0.25rem;
  }
  .emmc-device[data-active] {
    background: var(--muted);
    color: var(--foreground);
    box-shadow: inset 0 -2px var(--ring);
  }
  .emmc-description {
    display: grid;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .emmc-description p {
    grid-area: 1 / 1;
    margin: 0;
    visibility: hidden;
  }
  .emmc-description p[aria-hidden="false"] {
    visibility: visible;
  }
  .emmc-description strong {
    font-size: inherit;
    color: var(--foreground);
  }
  .lines {
    background-image: repeating-linear-gradient(
      135deg,
      transparent 0 7px,
      var(--pattern-ink) 7px 8px
    );
  }
  .dots {
    background-image: radial-gradient(
      circle,
      var(--pattern-ink) 1px,
      transparent 1px
    );
    background-size: 8px 8px;
  }
  .horizontal {
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0 7px,
      var(--pattern-ink) 7px 8px
    );
  }
  .crosshatch {
    background-image:
      repeating-linear-gradient(
        45deg,
        transparent 0 9px,
        var(--pattern-ink) 9px 10px
      ),
      repeating-linear-gradient(
        -45deg,
        transparent 0 9px,
        var(--pattern-ink) 9px 10px
      );
  }
  .emmc-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem clamp(0.2rem, 1vw, 0.75rem);
    background: var(--background);
    text-align: center;
  }
  strong {
    font-size: clamp(0.75rem, 2vw, 0.9375rem);
    font-weight: 600;
  }
  .emmc-label span {
    margin-top: 0.125rem;
    font-family: var(--font-mono);
    font-size: clamp(0.625rem, 1.7vw, 0.75rem);
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .emmc-layout,
    .emmc-access {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .emmc-access > span {
      padding: 0.5rem 0.25rem;
      font-size: 0.625rem;
    }
  }
</style>
