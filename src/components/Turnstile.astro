---
import type { FormKind } from "@/lib/sentry-form-metrics";

interface Props {
  action: FormKind;
}

const { action } = Astro.props;
const siteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "0x4AAAAAAEd_LCHW3k_8fBFt";
---

<div data-turnstile data-action={action} data-sitekey={siteKey}></div>
