---
import { Icon } from "astro-icon/components";
import NewsletterForm from "@/components/NewsletterForm.astro";
import NewsletterFormFields from "@/components/NewsletterFormFields.astro";

interface Props {
  variant?: "simple" | "inline" | "full";
  title?: string;
  className?: string;
  showRss?: boolean;
}

const {
  variant = "simple",
  title,
  className = "",
  showRss = true,
} = Astro.props;

// Generate unique IDs for form elements
const formId = `newsletter-${Math.random().toString(36).substring(2, 11)}`;
const emailId = `email-${formId}`;
const nameId = `name-${formId}`;
---

<div class={`newsletter-callout newsletter-${variant} ${className}`}>
  {
    variant === "simple" && (
      <div class="newsletter-simple">
        <div class="newsletter-header">
          <Icon name="email" size={20} class="newsletter-icon" />
          <span class="newsletter-title">Stay Updated</span>
        </div>
        <slot>
          <p class="newsletter-text">
            <em>
              P.S. I have a newsletter, but I'm so against spam, I very rarely
              send emails. Like this kind of stuff, very infrequently?
              <a href="/newsletter" class="newsletter-link">
                Subscribe here
              </a>
              {showRss && (
                <Fragment>
                  . I also have{" "}
                  <a href="/rss.xml" class="newsletter-link">
                    RSS
                  </a>
                </Fragment>
              )}
              !
            </em>
          </p>
        </slot>
      </div>
    )
  }

  {
    variant === "inline" && (
      <div class="newsletter-inline">
        <div class="newsletter-content">
          <div class="newsletter-header">
            <Icon name="email" size={24} class="newsletter-icon" />
            <div>
              <h3 class="newsletter-title">{title || "Stay in the Loop"}</h3>
              <p class="newsletter-subtitle">
                I <i>rarely</i> send emails, if you want only the good stuff,
                subscribe here.
              </p>
            </div>
          </div>

          <NewsletterForm className="newsletter-form">
            <NewsletterFormFields
              emailId={emailId}
              emailPlaceholder="homer.simpson@example.com"
              nameId={nameId}
              namePlaceholder="Your name (optional)"
              submitLabel="Subscribe"
              variant="inline"
            />
          </NewsletterForm>

          {showRss && (
            <div class="newsletter-rss">
              <Icon name="rss" size={16} />
              <span>
                Prefer RSS?{" "}
                <a href="/rss.xml" class="newsletter-link">
                  Grab the feed
                </a>
              </span>
            </div>
          )}
        </div>
      </div>
    )
  }

  {
    variant === "full" && (
      <div class="newsletter-full">
        <div class="newsletter-header">
          <Icon name="email" size={32} class="newsletter-icon" />
          <div>
            <h3 class="newsletter-title">{title || "Join the Newsletter"}</h3>
            <p class="newsletter-subtitle">
              Get notified about new posts, projects, and tech insights.
            </p>
          </div>
        </div>

        <div class="newsletter-benefits">
          <div class="benefit-item">
            <span class="benefit-emoji">📝</span>
            <span>New blog post notifications</span>
          </div>
          <div class="benefit-item">
            <span class="benefit-emoji">🚀</span>
            <span>Project launch announcements</span>
          </div>
          <div class="benefit-item">
            <span class="benefit-emoji">💡</span>
            <span>Exclusive tech insights</span>
          </div>
        </div>

        <NewsletterForm className="newsletter-form">
          <NewsletterFormFields
            emailId={emailId}
            emailPlaceholder="your.email@domain.com"
            nameId={nameId}
            namePlaceholder="Your name"
            submitLabel="Subscribe to Newsletter"
            variant="full"
          />
        </NewsletterForm>

        <div class="newsletter-footer">
          <p class="newsletter-promise">
            No spam, ever. Usually one email every few weeks.
          </p>
          {showRss && (
            <div class="newsletter-rss">
              <Icon name="rss" size={16} />
              <span>
                Prefer RSS?{" "}
                <a href="/rss.xml" class="newsletter-link">
                  Grab the feed
                </a>
              </span>
            </div>
          )}
        </div>
      </div>
    )
  }
</div>

<style>
  .newsletter-callout {
    margin: 3rem 0;
    padding: 1.5rem 0 1.25rem;
    border-block: 1px solid var(--color-border);
  }

  /* Simple variant */
  .newsletter-simple {
    text-align: left;
  }

  .newsletter-simple .newsletter-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .newsletter-simple .newsletter-title {
    font-weight: 600;
    color: var(--color-text-primary);
    font-size: 1rem;
  }

  .newsletter-simple .newsletter-text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Inline variant */
  .newsletter-inline .newsletter-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .newsletter-inline .newsletter-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem 0;
  }

  .newsletter-inline .newsletter-subtitle {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Full variant */
  .newsletter-full .newsletter-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .newsletter-full .newsletter-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem 0;
  }

  .newsletter-full .newsletter-subtitle {
    margin: 0;
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .newsletter-benefits {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding: 1rem 0;
    border-block: 1px solid var(--color-border);
  }

  .benefit-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .benefit-emoji {
    font-size: 1.25rem;
    width: 2rem;
    text-align: center;
  }

  .newsletter-footer {
    margin-top: 1.25rem;
  }

  .newsletter-promise {
    margin: 0 0 1rem 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Shared styles */
  .newsletter-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .newsletter-link {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .newsletter-link:hover {
    text-decoration-color: currentColor;
  }

  .newsletter-rss {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .newsletter-rss .newsletter-link {
    font-size: inherit;
  }

  .newsletter-form {
    position: relative;
  }

  /* Mobile responsive */
  @media (max-width: 720px) {
    .newsletter-callout {
      margin-top: 2rem;
      padding: 1.25rem 0;
    }

    .newsletter-inline .newsletter-header,
    .newsletter-full .newsletter-header {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .newsletter-benefits {
      padding: 1rem;
    }

    .benefit-item {
      font-size: 0.85rem;
    }
  }
</style>
