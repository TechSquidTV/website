---
interface Props {
  minutesRead?: string | undefined;
  wordCount?: number | undefined;
  className?: string;
}

const { minutesRead, wordCount, className = "" } = Astro.props;
---

{
  minutesRead && (
    <span class={`text-text-muted ${className}`}>
      {minutesRead}
      {wordCount && <span> · {wordCount.toLocaleString()} words</span>}
    </span>
  )
}
