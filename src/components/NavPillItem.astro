---
interface Props {
  href: string;
  label: string;
  isActive?: boolean;
  className?: string;
}

const { href, label, isActive = false, className = "" } = Astro.props;
---

<a
  href={href}
  class={`pill-nav-item mx-0.5 inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-semibold text-muted-foreground no-underline transition-colors hover:bg-muted hover:text-foreground ${className}`}
  data-active={isActive}
>
  {label}
</a>

<style>
  .pill-nav-item[data-active="true"] {
    color: var(--foreground);
    background: var(--muted);
  }
</style>
