---
import { Icon } from "astro-icon/components";
import { PERSONAL_INFO, SITE_TITLE } from "../consts";

const today = new Date();
---

<footer class="border-border border-t">
  <div
    class="container-page flex flex-col gap-3 py-6 text-sm sm:flex-row sm:items-center sm:justify-between"
  >
    <a
      href="/"
      class="text-muted-foreground flex items-center gap-2 no-underline"
    >
      <Icon name="techsquidtv" size={20} aria-label="TechSquidTV logo" />
      <span>© {today.getFullYear()} {SITE_TITLE}</span>
    </a>
    <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer navigation">
      <a
        href="/blog"
        class="text-muted-foreground hover:text-foreground no-underline transition-colors"
      >
        Blog
      </a>
      <a
        href="/follow"
        class="text-muted-foreground hover:text-foreground no-underline transition-colors"
      >
        Follow
      </a>
      <a
        href="/rss.xml"
        class="text-muted-foreground hover:text-foreground no-underline transition-colors"
      >
        RSS
      </a>
      <a
        href={`mailto:${PERSONAL_INFO.email}`}
        class="text-muted-foreground hover:text-foreground no-underline transition-colors"
      >
        Contact
      </a>
    </nav>
  </div>
</footer>
