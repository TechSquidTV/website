---
import FormSubmissionDialog from "@/components/FormSubmissionDialog.astro";
import FormSubmissionScript from "@/components/FormSubmissionScript.astro";
import type { NewsletterMetricPlacement } from "@/lib/sentry-form-metrics";

interface Props {
  className?: string;
  placement?: NewsletterMetricPlacement;
}

const { className = "", placement = "other" } = Astro.props;
const formId = `newsletter-form-${Math.random().toString(36).substring(2, 11)}`;
const dialogId = `${formId}-dialog`;
---

<form
  id={formId}
  data-form-endpoint="/api/forms/newsletter"
  data-form-dialog={dialogId}
  data-form-kind="newsletter"
  data-sentry-placement={placement}
  class={className}
>
  <div class="absolute left-[-9999px] opacity-0" aria-hidden="true">
    <label>
      Don't fill this out if you're human: <input
        name="dontCheckMe"
        tabindex="-1"
      />
    </label>
  </div>

  <slot />
  <p data-form-status class="mt-4 text-sm" aria-live="polite"></p>
  <p class="text-text-muted mt-3 text-sm">
    We respect your inbox. Read our <a href="/privacy">Privacy Policy</a>.
  </p>
</form>

<FormSubmissionDialog formKind="newsletter" id={dialogId} />

<FormSubmissionScript />
