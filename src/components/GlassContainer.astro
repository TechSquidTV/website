---
interface Props {
  variant?: "pillbox" | "nav" | "panel" | "circle";
  className?: string;
}

const { variant = "panel", className = "" } = Astro.props;

const variantClasses = {
  pillbox:
    "inline-flex items-center rounded-full border border-border bg-card py-2 pl-2 pr-4 shadow-sm transition-colors hover:bg-muted md:py-1.5 md:pl-1.5 md:pr-3",
  circle:
    "flex h-12 w-12 items-center justify-center rounded-full border border-border bg-card text-foreground shadow-sm transition-colors hover:bg-muted",
  nav: "flex items-center rounded-full border border-border bg-card px-2 py-1 shadow-sm",
  panel: "rounded-lg border border-border bg-card shadow-sm",
};
---

<div class={`${variantClasses[variant]} ${className}`}>
  <slot />
</div>
