---
import Avatar from "@/components/Avatar.astro";
import PageHeader from "@/components/PageHeader.astro";
import StructuredData from "@/components/StructuredData.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AvatarImage from "@/images/brand/tstvprofile.png";
import { SOCIAL_LINKS, PERSONAL_INFO, SITE_TITLE } from "@/consts";

const YouTube = SOCIAL_LINKS.find((link) => link.name === "YouTube")!.url;
---

<BaseLayout
  title={`About - ${SITE_TITLE}`}
  description={`Learn about ${PERSONAL_INFO.name}, the developer and educator behind ${SITE_TITLE}`}
>
  <StructuredData />

  <PageHeader title={`About ${SITE_TITLE}`} />

  <div
    class="text-text-secondary space-y-10 leading-relaxed"
    itemscope
    itemtype="https://schema.org/Person"
  >
    <meta itemprop="name" content={PERSONAL_INFO.name} />
    <meta itemprop="alternateName" content={PERSONAL_INFO.username} />
    <meta itemprop="jobTitle" content={PERSONAL_INFO.jobTitle} />
    <meta itemprop="url" content={PERSONAL_INFO.website} />

    <section class="space-y-4">
      <Avatar
        src={AvatarImage}
        alt={`${PERSONAL_INFO.name} - ${SITE_TITLE}`}
        size="xl"
        className="float-right mb-4 ml-6 max-sm:float-none max-sm:mx-auto max-sm:mb-5 max-sm:block"
      />
      <p class="text-lg">
        I am <span itemprop="name">{PERSONAL_INFO.name}</span>, better known
        online as <span itemprop="alternateName">@{PERSONAL_INFO.username}</span
        >.
      </p>

      <p class="text-lg">
        I'm a self-taught developer who grew up at the dawn of the internet with
        a computer and a curiosity for how things worked.
      </p>

      <p class="text-lg">
        Today, I work as a <span itemprop="jobTitle"
          >{PERSONAL_INFO.corporateRole}</span
        > at {PERSONAL_INFO.corporateCompany}, writing blog posts and making
        videos for developers.
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-text-primary text-2xl font-semibold">How I Got Here</h2>
      <p class="text-lg">
        In 2016, I rebranded and started a new YouTube channel <a
          href={YouTube}
          target="_blank">{SITE_TITLE}</a
        > while working in retail, and taking another, more serious attempt at studying
        development. The channel acted as a way for me to manage my own learning,
        setting a goal of learning a topic completely enough to be able to teach it
        to others. I also took the opportunity with each video to implement a new
        editing technique, improving my editing skills as I learned to code.
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-text-primary text-2xl font-semibold">What I Make</h2>
      <p class="text-lg">
        I'm a TypeScript developer mostly, but explore a wide range of
        technologies and disciplines. I make web applications, because they are
        useful. I also make videos, dabble in 3D modeling, and experiment with
        hardware, because they are fun.
      </p>

      <p class="text-lg">
        I've been known to go down a rabbit hole of research on interesting and
        obscure topics, and I think hope I can provide a good balance of
        practical and entertaining content for developers and makers of all
        skill levels.
      </p>
    </section>
  </div>
</BaseLayout>
