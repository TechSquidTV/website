---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import BaseHead from "../../../components/BaseHead.astro";
import BlogPostList from "../../../components/BlogPostList.astro";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import { SITE_TITLE } from "../../../consts";
import { publishedPostFilter } from "../../../utils/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", publishedPostFilter);
  const uniqueTags = [
    ...new Set(allPosts.map((post) => post.data.tags ?? []).flat()),
  ];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort(
        (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
      );

    return {
      params: { tag },
      props: { posts: filteredPosts, tag },
    };
  });
}

const { posts, tag } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${tag} Posts - ${SITE_TITLE}`}
      description={`All posts tagged with ${tag}`}
    />
  </head>
  <body>
    <ClientRouter />
    <Header />
    <main class="container-page py-10 sm:py-14">
      <header class="mb-8">
        <h1 class="text-foreground mb-2 text-4xl leading-tight font-bold">
          #{tag}
        </h1>
        <p class="text-muted-foreground m-0">
          {posts.length} post{posts.length !== 1 ? "s" : ""}
        </p>
      </header>
      <BlogPostList posts={posts} />
    </main>
    <Footer />
  </body>
</html>
