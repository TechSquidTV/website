---
import { Icon } from "astro-icon/components";
import Button from "@/components/Button.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const services = [
  {
    title: "Screencasts",
    anchor: "screencasts",
    icon: "playCircle",
    summary:
      "Product demos and tutorials that make technical ideas easy to follow.",
    description:
      "Give developers a practical path from first look to confident use with focused, polished video content.",
    offerings: [
      {
        title: "Feature demos",
        description:
          "Show the value of a feature with a clear, developer-first walkthrough.",
      },
      {
        title: "Tutorials",
        description:
          "Turn a real workflow into an approachable learning experience for your audience.",
      },
      {
        title: "Short-form video",
        description:
          "Create concise clips for product launches, social channels, and documentation.",
      },
    ],
  },
  {
    title: "Animation",
    anchor: "animations",
    icon: "techsquidtv",
    summary: "Motion design that makes complex systems feel intuitive.",
    description:
      "Use animation to explain architecture, tell a product story, or give your launch a memorable visual edge.",
    offerings: [
      {
        title: "Explainers",
        description:
          "Translate an abstract concept into a visual story your audience can understand quickly.",
      },
      {
        title: "Product visuals",
        description:
          "Create purposeful motion assets for launches, talks, landing pages, and social content.",
      },
      {
        title: "3D animation",
        description:
          "Bring technical products and physical projects to life with dimensional, polished visuals.",
      },
    ],
  },
  {
    title: "Writing",
    anchor: "writing",
    icon: "git",
    summary: "Technical writing that helps developers learn, build, and share.",
    description:
      "Create useful documentation and editorial content with the perspective of an experienced software engineer and educator.",
    offerings: [
      {
        title: "Developer articles",
        description:
          "Publish useful, search-friendly stories that connect your product to real developer work.",
      },
      {
        title: "Documentation",
        description:
          "Improve the path from first setup to productive use with clear, maintainable docs.",
      },
      {
        title: "Content strategy",
        description:
          "Plan an evergreen library of tutorials, guides, and launch content around your goals.",
      },
    ],
  },
  {
    title: "Code",
    anchor: "code",
    icon: "github",
    summary: "Developer-focused software and tooling built for real-world use.",
    description:
      "Extend your product with thoughtful integrations, reliable automation, and tools that meet developers where they work.",
    offerings: [
      {
        title: "Custom applications",
        description:
          "Build the right web application, API, or internal tool for your product and team.",
      },
      {
        title: "CI/CD automation",
        description:
          "Make releases more dependable with workflows and integrations designed around your delivery process.",
      },
      {
        title: "Client SDKs",
        description:
          "Help developers adopt your platform with ergonomic, well-supported SDKs across the right languages.",
      },
    ],
  },
];
---

<BaseLayout
  title="DevRel Services by TechSquidTV"
  description="Developer relations, content, and software services by Kyle Tryon."
>
  <section class="surface-card mb-12 overflow-hidden p-6 sm:p-10">
    <div class="max-w-2xl">
      <span class="section-eyebrow">Developer relations services</span>
      <h1
        class="text-foreground mt-5 text-4xl font-bold tracking-tight sm:text-5xl"
      >
        Help developers understand what you build.
      </h1>
      <p class="text-muted-foreground mt-5 text-lg leading-8">
        I partner with technical teams to create useful content, compelling
        visuals, and dependable developer experiences.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <Button href="/contact">Start a conversation</Button>
        <Button href="#services" variant="secondary">Explore services</Button>
      </div>
    </div>
  </section>

  <nav aria-label="Services" class="mb-12" id="services">
    <ul class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      {
        services.map((service) => (
          <li>
            <a
              class="surface-muted focus-ring hover:bg-card flex h-full items-center gap-3 px-4 py-3 text-sm font-semibold no-underline transition-colors"
              href={`#${service.anchor}`}
            >
              <Icon name={service.icon} size={20} aria-hidden="true" />
              {service.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="divide-border divide-y">
    {
      services.map((service) => (
        <section class="scroll-mt-24 py-12 sm:py-16" id={service.anchor}>
          <div class="grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12">
            <div>
              <div class="flex items-center gap-3">
                <Icon
                  name={service.icon}
                  size={28}
                  class="text-primary"
                  aria-hidden="true"
                />
                <h2 class="text-foreground text-3xl font-bold tracking-tight">
                  {service.title}
                </h2>
              </div>
              <p class="text-foreground mt-5 text-lg font-medium">
                {service.summary}
              </p>
              <p class="text-muted-foreground mt-3 leading-7">
                {service.description}
              </p>
              <Button
                href="/contact"
                variant="secondary"
                size="sm"
                className="mt-6"
              >
                Discuss {service.title.toLowerCase()}
              </Button>
            </div>

            <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
              {service.offerings.map((offering) => (
                <article class="surface-card p-5">
                  <h3 class="text-foreground font-semibold">
                    {offering.title}
                  </h3>
                  <p class="text-muted-foreground mt-2 text-sm leading-6">
                    {offering.description}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <section
    class="surface-muted mt-4 rounded-lg p-6 text-center sm:mt-8 sm:p-10"
  >
    <h2 class="text-foreground text-2xl font-bold tracking-tight">
      Need a tailored mix of services?
    </h2>
    <p class="text-muted-foreground mx-auto mt-3 max-w-xl">
      Every engagement is scoped around your product, audience, and goals. Get
      in touch to talk through the right approach.
    </p>
    <Button href="/contact" className="mt-6">Get in touch</Button>
  </section>
</BaseLayout>
