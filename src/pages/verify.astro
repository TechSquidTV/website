---
import { Icon } from "astro-icon/components";
import Button from "@/components/Button.astro";
import PageHeader from "@/components/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { GPG_INFO } from "@/consts";

const { fingerprint, publicKeyUrl } = GPG_INFO;
---

<BaseLayout
  title="Verify Identity - TechSquidTV"
  description="Verify the identity of Kyle Tryon using cryptographic verification"
>
  <PageHeader title="Verify my identity">
    <div class="text-text-secondary space-y-4 text-lg leading-relaxed">
      <p>
        This public GPG key lets you verify signed messages and confirm that
        you’re communicating with me.
      </p>
      <p>
        Official accounts are listed on <a href="/follow">/follow</a>. For an
        encrypted message, use the contact page after importing the key below.
      </p>
    </div>
  </PageHeader>

  <div class="mt-10">
    <section class="border-border border-t pt-6 sm:pt-8">
      <p
        class="text-muted-foreground mb-2 text-sm font-medium tracking-[var(--tracking-caps-sm)] uppercase"
      >
        GPG public key
      </p>
      <h2 class="text-text-primary mb-5 text-2xl font-semibold">Fingerprint</h2>
      <div class="bg-bg-code border-border mb-6 rounded-md border px-4 py-3">
        <code
          class="text-foreground font-mono text-sm tracking-wide break-all select-all md:text-base md:break-normal"
        >
          {fingerprint}
        </code>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button href={publicKeyUrl} variant="primary">
          <Icon name="key" size={20} />
          Download Public Key
        </Button>
        <a
          href="/contact"
          class="text-muted-foreground hover:text-foreground text-sm font-medium no-underline transition-colors"
        >
          Send encrypted message →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
