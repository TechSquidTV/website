---
import { render } from "astro:content";
import { YouTube } from "@astro-community/astro-embed-youtube";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import BlogPostList from "@/components/BlogPostList.astro";
import NewsletterLink from "@/components/NewsletterLink.astro";
import savedVideo from "@/lib/latest-youtube-video.json";
import {
  SITE_DESCRIPTION,
  SITE_TAGLINE_LINES,
  SITE_TITLE,
  YOUTUBE_CHANNEL_ID,
} from "@/consts";
import { getPublishedPosts } from "@/utils/blog";

const posts = await getPublishedPosts(true);
const recentPostsWithReadingTime = await Promise.all(
  posts.slice(0, 3).map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return { ...post, readingTime: remarkPluginFrontmatter };
  }),
);

type LatestVideo = {
  id: string;
  title: string;
  published: Date | null;
};

// Keep the last published showcase available offline and when YouTube is down.
// Production refreshes at build time; visitors and dev previews make no feed requests.
let latestVideo: LatestVideo = {
  ...savedVideo,
  published: new Date(`${savedVideo.published}T12:00:00Z`),
};

if (import.meta.env.PROD) {
  try {
    const response = await fetch(
      `https://www.youtube.com/feeds/videos.xml?channel_id=${YOUTUBE_CHANNEL_ID}`,
      { signal: AbortSignal.timeout(5000) },
    );
    if (!response.ok)
      throw new Error(`YouTube feed returned ${response.status}`);

    const xmlText = await response.text();
    const entry = xmlText.match(/<entry>(.*?)<\/entry>/s)?.[1];
    const id = entry?.match(/<yt:videoId>(.*?)<\/yt:videoId>/)?.[1];
    const title =
      entry?.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/s)?.[1] ??
      entry?.match(/<title>(.*?)<\/title>/s)?.[1];
    const published = entry?.match(/<published>(.*?)<\/published>/)?.[1];
    if (!id || !/^[\w-]{11}$/.test(id) || !title) {
      throw new Error("YouTube feed has no valid video entry");
    }
    const date = published ? new Date(published) : null;
    latestVideo = {
      id,
      title,
      published: date && Number.isFinite(date.getTime()) ? date : null,
    };
  } catch (error) {
    console.warn("Using saved YouTube showcase:", error);
  }
}
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section
    class="border-border mb-12 border-b pb-8 text-center"
    aria-labelledby="home-heading"
  >
    <p class="section-eyebrow">{SITE_TITLE}</p>
    <h1
      id="home-heading"
      class="text-foreground mx-auto mt-5 max-w-2xl text-4xl leading-tight font-semibold text-balance sm:text-5xl"
    >
      {SITE_TAGLINE_LINES[0]}
    </h1>
    <p
      class="text-muted-foreground mx-auto mt-5 max-w-xl text-lg leading-8 first-letter:uppercase"
    >
      {SITE_TAGLINE_LINES[1]}
    </p>
    <div
      class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-4"
    >
      <Button href="/blog/"
        >Explore the blog <span aria-hidden="true">→</span></Button
      >
      <NewsletterLink
        className="focus-ring text-muted-foreground hover:text-foreground inline-flex items-center gap-2 py-3 text-sm font-medium no-underline transition-colors"
      >
        <Icon name="email" size={17} aria-hidden="true" />
        Get the newsletter <span aria-hidden="true">→</span>
      </NewsletterLink>
    </div>
  </section>

  <section aria-label="Recent posts">
    <BlogPostList
      posts={recentPostsWithReadingTime}
      featured
      showFeaturedImage
      imageLimit={3}
    />
    <Button href="/blog/" variant="secondary" fullWidth className="mt-4">
      All posts <span aria-hidden="true">→</span>
    </Button>
  </section>

  <section
    class="border-border mt-8 border-t pt-8"
    aria-labelledby="latest-video-heading"
  >
    <p class="section-eyebrow mb-3">Latest video</p>
    <h2
      id="latest-video-heading"
      class="text-foreground mb-2 text-2xl leading-tight font-semibold"
    >
      {latestVideo.title}
    </h2>
    {
      latestVideo.published && (
        <p class="text-muted-foreground mb-6 text-sm">
          {new Intl.DateTimeFormat("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          }).format(latestVideo.published)}
        </p>
      )
    }
    <div class="border-border content-block overflow-hidden border">
      <YouTube
        id={latestVideo.id}
        title={latestVideo.title}
        style="max-width: none;"
      />
    </div>
    <a
      href={`https://www.youtube.com/watch?v=${latestVideo.id}`}
      data-sentry-cta="watch_youtube"
      data-sentry-cta-placement="home_video"
      target="_blank"
      rel="noopener noreferrer"
      class="focus-ring text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm font-medium no-underline transition-colors"
    >
      Watch on YouTube <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
