---
import { render } from "astro:content";
import { YouTube } from "@astro-community/astro-embed-youtube";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";
import BaseHead from "@/components/BaseHead.astro";
import BlogPostList from "@/components/BlogPostList.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import NewsletterLink from "@/components/NewsletterLink.astro";
import {
  SITE_DESCRIPTION,
  SITE_TAGLINE_LINES,
  SITE_TITLE,
  YOUTUBE_CHANNEL_ID,
} from "@/consts";
import { getPublishedPosts } from "@/utils/blog";

const posts = await getPublishedPosts(true);
const recentPostsWithReadingTime = await Promise.all(
  posts.slice(0, 3).map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return { ...post, readingTime: remarkPluginFrontmatter };
  }),
);

type LatestVideo = {
  title: string;
  url: string;
  published: Date | null;
};

function extractVideoId(url: string): string | null {
  const match = url.match(
    /(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})/,
  );
  return match?.[1] ?? null;
}

let latestVideo: LatestVideo | null = null;
let videoId: string | null = null;

try {
  const response = await fetch(
    `https://www.youtube.com/feeds/videos.xml?channel_id=${YOUTUBE_CHANNEL_ID}`,
  );

  if (response.ok) {
    const xmlText = await response.text();
    const entry = xmlText.match(/<entry>(.*?)<\/entry>/s)?.[1];

    if (entry) {
      const title =
        entry.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/)?.[1] ??
        entry.match(/<title>(.*?)<\/title>/)?.[1];
      const url = entry.match(/<link rel="alternate" href="(.*?)"/)?.[1];
      const published = entry.match(/<published>(.*?)<\/published>/)?.[1];
      const feedVideoId = entry.match(/<yt:videoId>(.*?)<\/yt:videoId>/)?.[1];

      if (title && url) {
        latestVideo = {
          title,
          url,
          published: published ? new Date(published) : null,
        };
        videoId = feedVideoId ?? extractVideoId(url);
      }
    }
  }
} catch (error) {
  console.log("Could not fetch YouTube RSS:", error);
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <ClientRouter />
    <Header />

    <main>
      <section class="border-border border-b">
        <div class="container-page py-10 sm:py-14">
          <div
            class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between"
          >
            <div>
              <p
                class="text-foreground mb-5 text-sm font-medium tracking-(--tracking-caps-sm) uppercase"
              >
                TechSquidTV
              </p>
              <h1
                class="text-foreground max-w-4xl text-3xl leading-[1.12] font-semibold tracking-tight text-balance sm:text-4xl"
              >
                {
                  SITE_TAGLINE_LINES.map((line) => (
                    <span class="block">{line}</span>
                  ))
                }
              </h1>
            </div>
            <NewsletterLink
              className="text-muted-foreground hover:text-foreground inline-flex shrink-0 items-center gap-2 text-sm font-medium no-underline transition-colors"
            >
              <Icon name="email" size={17} aria-hidden="true" />
              Get the newsletter <span aria-hidden="true">→</span>
            </NewsletterLink>
          </div>
        </div>
      </section>

      <section class="container-page py-10 sm:py-14">
        <div class="mb-7 flex items-baseline justify-between gap-4">
          <h2
            class="text-foreground m-0 text-sm font-medium tracking-(--tracking-caps-sm) uppercase"
          >
            Latest writing
          </h2>
          <a
            href="/blog"
            class="text-muted-foreground hover:text-foreground text-sm no-underline transition-colors"
          >
            All posts
          </a>
        </div>
        <BlogPostList
          posts={recentPostsWithReadingTime}
          featured
          showFeaturedImage
        />
      </section>

      {
        videoId && latestVideo && (
          <section class="border-border border-t">
            <div class="container-page py-10 sm:py-14">
              <p class="text-muted-foreground mb-3 text-sm font-medium tracking-(--tracking-caps-sm) uppercase">
                Latest video
              </p>
              <h2 class="text-foreground mb-2 text-2xl leading-tight font-semibold">
                {latestVideo.title}
              </h2>
              {latestVideo.published && (
                <p class="text-muted-foreground mb-6 text-sm">
                  {new Intl.DateTimeFormat("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  }).format(latestVideo.published)}
                </p>
              )}
              <div class="aspect-video overflow-hidden rounded-md">
                <YouTube id={videoId} />
              </div>
              <a
                href={latestVideo.url}
                data-sentry-cta="watch_youtube"
                data-sentry-cta-placement="home_video"
                target="_blank"
                rel="noopener noreferrer"
                class="text-foreground decoration-border hover:decoration-primary mt-5 inline-flex font-medium underline transition-colors"
              >
                Watch on YouTube →
              </a>
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </body>
</html>
