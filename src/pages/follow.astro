---
import { Icon } from "astro-icon/components";
import ContactInfo from "@/components/ContactInfo.astro";
import NewsletterCallout from "@/components/NewsletterCallout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PERSONAL_INFO, SITE_TITLE, SOCIAL_LINKS } from "@/consts";

const pageTitle = `Follow ${PERSONAL_INFO.name} - ${SITE_TITLE}`;
const pageDescription = `Connect with ${PERSONAL_INFO.name} (${PERSONAL_INFO.username}) across all social platforms.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHeader title="Follow TechSquidTV">
    <p class="text-text-secondary text-lg leading-relaxed">
      Tutorials, projects, and occasional experiments in developer experience,
      open source, and tech education.
    </p>
    <ContactInfo email={PERSONAL_INFO.email} className="mt-5" />
  </PageHeader>

  <nav class="border-border border-t" aria-label="Social profiles">
    {
      SOCIAL_LINKS.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="border-border text-foreground hover:text-primary flex items-center gap-3 border-b py-4 no-underline transition-colors"
        >
          <Icon name={social.icon} size={18} class="text-muted-foreground" />
          <span class="font-medium">{social.name}</span>
          <span class="text-muted-foreground ml-auto text-sm">Visit →</span>
        </a>
      ))
    }
  </nav>

  <NewsletterCallout
    variant="inline"
    title="Get updates by email"
    placement="follow_inline"
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      mainEntity: {
        "@type": "Person",
        name: PERSONAL_INFO.name,
        alternateName: PERSONAL_INFO.username,
        description: pageDescription,
        url: PERSONAL_INFO.website,
        email: PERSONAL_INFO.email,
        jobTitle: PERSONAL_INFO.jobTitle,
        worksFor: {
          "@type": "Organization",
          name: PERSONAL_INFO.corporateCompany,
        },
        sameAs: SOCIAL_LINKS.map((link) => link.url),
      },
    })}
  />
</BaseLayout>
