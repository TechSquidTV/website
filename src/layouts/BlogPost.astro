---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";
import BaseHead from "@/components/BaseHead.astro";
import BlogImageLightbox from "@/components/BlogImageLightbox.astro";
import StructuredData from "@/components/StructuredData.astro";
import BreadcrumbSchema from "@/components/BreadcrumbSchema.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Header from "@/components/Header.astro";
import ReadingTimeDisplay from "@/components/ReadingTimeDisplay.astro";
import BlogComments from "@/components/BlogComments.astro";
import { PERSONAL_INFO, SITE_TITLE } from "@/consts";
import { OPEN_GRAPH_IMAGE_EXTENSION } from "@/lib/open-graph-theme";
import { contentTopic } from "@/lib/analytics-taxonomy";
import type { GitHubDiscussionSnapshot } from "@/lib/github-discussions";

type Props = CollectionEntry<"blog">["data"] & {
  sourceFilePath: string;
  readingTime?: {
    minutesRead?: string;
    readingTimeMinutes?: number;
    wordCount?: number;
  };
  discussion?: GitHubDiscussionSnapshot | undefined;
};

const {
  title,
  description,
  publishDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  readingTime,
  tags,
  sources,
  analyticsTopic,
  sourceFilePath,
  discussion,
} = Astro.props;

// Extract the blog slug from pathname (remove /blog/ prefix and trailing slash)
const blogSlug = Astro.url.pathname.replace(/^\/blog\//, "").replace(/\/$/, "");
const ogImage = new URL(
  `/open-graph/blog/${blogSlug}.${OPEN_GRAPH_IMAGE_EXTENSION}`,
  Astro.site,
).href;
const githubEditUrl = `https://github.com/TechSquidTV/website/edit/main/${sourceFilePath}`;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      type="article"
      publishDate={publishDate}
      updatedDate={updatedDate}
      tags={tags}
    />
    <StructuredData
      type="BlogPosting"
      pageUrl={Astro.url.href}
      title={title}
      description={description}
      publishDate={publishDate}
      updatedDate={updatedDate}
      readingTime={readingTime?.readingTimeMinutes}
      wordCount={readingTime?.wordCount}
      sources={sources}
    />
    <BreadcrumbSchema
      items={[
        { name: SITE_TITLE, url: Astro.site!.toString() },
        { name: "Blog", url: `${Astro.site}blog/` },
        { name: title, url: Astro.url.href },
      ]}
    />
  </head>

  <body>
    <ClientRouter />
    <Header />
    <main id="main-content" tabindex="-1" class="container-page py-10 sm:py-14">
      <article
        class="blog-image-lightbox-root"
        data-sentry-blog-post
        data-sentry-post-slug={blogSlug}
        data-sentry-content-topic={contentTopic(analyticsTopic)}
        itemscope
        itemtype="https://schema.org/BlogPosting"
      >
        <div class="prose prose-lg text-text-secondary">
          {
            heroImage && (
              <Image
                width={1440}
                height={720}
                src={heroImage}
                alt={heroImageAlt || title}
                layout="constrained"
                sizes="(min-width: 768px) 720px, (min-width: 640px) calc(100vw - 3rem), calc(100vw - 2rem)"
                loading="eager"
                fetchpriority="high"
                class="mb-10 h-auto w-full"
                transition:name={`hero-${blogSlug}`}
              />
            )
          }
          <header class="mb-10">
            <h1
              class="text-text-primary mb-0 text-4xl leading-tight font-bold md:text-5xl"
              itemprop="headline"
            >
              {title}
            </h1>
            <div class="mt-4 flex items-start gap-4">
              <div
                class="text-text-muted flex flex-wrap items-center gap-x-2 gap-y-1 text-sm"
              >
                <span
                  itemprop="author"
                  itemscope
                  itemtype="https://schema.org/Person"
                  class="inline-flex items-center gap-1"
                >
                  <Icon name="person" size={14} aria-hidden="true" />
                  <a
                    itemprop="url"
                    href="/about/"
                    rel="author"
                    class="hover:text-text-primary transition-colors"
                    ><span itemprop="name">{PERSONAL_INFO.name}</span></a
                  >
                </span>
                <time
                  itemprop="datePublished"
                  datetime={publishDate.toISOString()}
                  class="inline-flex items-center gap-1"
                >
                  <Icon name="event" size={14} aria-hidden="true" />
                  <FormattedDate date={publishDate} />
                </time>
                {
                  readingTime?.minutesRead && (
                    <span class="inline-flex items-center gap-1">
                      <Icon name="schedule" size={14} aria-hidden="true" />
                      <ReadingTimeDisplay
                        minutesRead={readingTime.minutesRead}
                        wordCount={readingTime.wordCount}
                        className="text-sm"
                      />
                    </span>
                  )
                }
                {
                  updatedDate && (
                    <>
                      <span>
                        Updated{" "}
                        <time
                          itemprop="dateModified"
                          datetime={updatedDate.toISOString()}
                        >
                          <FormattedDate date={updatedDate} />
                        </time>
                      </span>
                    </>
                  )
                }
              </div>
              <a
                href="/rss.xml"
                rel="alternate"
                type="application/rss+xml"
                class="text-muted-foreground hover:text-foreground ml-auto inline-flex shrink-0 items-center gap-1.5 text-sm no-underline transition-colors"
                aria-label="Subscribe to the RSS feed"
              >
                <Icon name="rss" size={16} aria-hidden="true" />
                RSS
              </a>
            </div>

            {
              tags && tags.length > 0 && (
                <nav
                  class="mt-4 flex flex-wrap gap-x-3 gap-y-1"
                  aria-label="Tags"
                >
                  {tags.map((tag) => (
                    <a
                      href={`/blog/tags/${tag}/`}
                      rel="tag"
                      class="text-muted-foreground hover:text-foreground text-sm no-underline transition-colors"
                    >
                      #{tag}
                    </a>
                  ))}
                </nav>
              )
            }
            <link itemprop="url" href={Astro.url.href} />
          </header>

          <p
            class="text-text-primary border-border mx-auto mt-0 mb-10 max-w-2xl border-y px-4 py-5 text-center text-base leading-relaxed italic sm:px-8 sm:text-lg"
            itemprop="description"
          >
            {description}
          </p>

          <!-- Main Content -->
          <section class="blog-content">
            <slot />
          </section>
          {discussion && <BlogComments discussion={discussion} />}
          <footer class="not-prose mt-12 flex justify-center pt-8">
            <a
              href={githubEditUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-text-primary inline-flex items-center gap-2 text-sm font-medium no-underline transition-colors"
            >
              <Icon name="pencil" size={16} aria-hidden="true" />
              Suggest an edit to this page
            </a>
          </footer>
        </div>
      </article>
    </main>
    <Footer />
    <BlogImageLightbox />
  </body>
</html>
