{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "imports": {
    "#utils/*": "./src/utils/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:ops": "wrangler deploy --config wrangler.ops.jsonc",
    "cf-typegen": "wrangler types",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm spellcheck && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint-import-aliases.mjs && eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "spellcheck": "cspell lint --no-progress .",
    "indexnow:submit": "tsx scripts/submit-indexnow.ts",
    "discussions:prepare": "tsx scripts/sync-blog-discussions.ts --prepare",
    "discussions:provision": "tsx scripts/sync-blog-discussions.ts --provision",
    "discussions:backfill:prepare": "tsx scripts/sync-blog-discussions.ts --prepare --backfill",
    "discussions:backfill:provision": "tsx scripts/sync-blog-discussions.ts --provision --backfill",
    "newsletter:publish": "tsx --tsconfig tsconfig.email.json scripts/publish-newsletter-template.tsx",
    "sentry:sync": "bash scripts/sync-sentry-observability.sh"
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/outfit": "^5.3.0",
    "@preline/accordion": "^5.0.0",
    "@preline/tree-view": "^5.0.0",
    "@sentry/astro": "^10.71.0",
    "@sentry/cloudflare": "^10.71.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "7.3.8",
    "astro-icon": "^1.2.0",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.42.0",
    "clsx": "^2.1.1",
    "hast-util-sanitize": "^5.0.2",
    "lucide-react": "^1.34.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-toc": "^9.0.0",
    "resend": "6.32.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cspell": "10.3.6",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.14.0",
    "knip": "^6.32.3",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sentry": "0.47.0",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
